{
  "name": "@regal-text-editor/ui",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "description": "Default React toolbar UI built on @regal-text-editor/react's hooks \u2014 configurable, replaceable, not required to use the engine.",
  "keywords": [
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "contenteditable",
    "regal-text-editor",
    "react",
    "toolbar",
    "ui-components"
  ],
  "author": {
    "name": "mohammad-mirzaie-gh",
    "url": "https://github.com/mohammad-mirzaie-gh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammad-mirzaie-gh/regal-text-editor.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/mohammad-mirzaie-gh/regal-text-editor/issues"
  },
  "homepage": "https://regal-text-editor.vercel.app",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --external react --external react-dom && cp src/styles.css dist/styles.css",
    "dev": "tsup src/index.ts --format esm --dts --sourcemap --watch --external react --external react-dom"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@regal-text-editor/browser": "workspace:*",
    "@regal-text-editor/core": "workspace:*",
    "@regal-text-editor/plugin-link": "workspace:*",
    "@regal-text-editor/react": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
