{
  "name": "@regal-text-editor/core",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "description": "Framework-independent rich text editor engine: document model, schema, transactions, selection, commands, history, normalization and serialization.",
  "keywords": [
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "contenteditable",
    "regal-text-editor",
    "headless",
    "document-model",
    "schema"
  ],
  "author": {
    "name": "mohammad-mirzaie-gh",
    "url": "https://github.com/mohammad-mirzaie-gh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammad-mirzaie-gh/regal-text-editor.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mohammad-mirzaie-gh/regal-text-editor/issues"
  },
  "homepage": "https://regal-text-editor.vercel.app",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "dev": "tsup src/index.ts --format esm --dts --sourcemap --watch"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
