{
  "name": "@regal-text-editor/plugin-image",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "description": "Block-level image node: schema, insert command, and HTML/Markdown import/export.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "dev": "tsup src/index.ts --format esm --dts --sourcemap --watch"
  },
  "dependencies": {
    "@regal-text-editor/core": "workspace:*"
  },
  "devDependencies": {
    "@regal-text-editor/plugin-basic-blocks": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
