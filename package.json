{
  "name": "text-editor-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for a framework-independent rich text editor engine and its plugins/UI/React binding.",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/** run build",
    "dev:example": "pnpm --filter basic-editor-example run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "pnpm -r --filter=./packages/** exec tsc --noEmit",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
